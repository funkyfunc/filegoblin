{
  "name": "filegoblin",
  "version": "1.13.0",
  "description": "Zero-dependency single-binary CLI converting any file or URL into clean Markdown for LLMs",
  "main": "./bin/filegoblin.js",
  "bin": {
    "filegoblin": "./bin/filegoblin.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funkyfunc/filegoblin.git"
  },
  "keywords": [
    "markdown",
