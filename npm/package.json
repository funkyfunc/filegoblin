    "pdf",
    "docx",
    "pptx",
    "converter",
    "cli"
  ],
  "author": "filegoblin contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/funkyfunc/filegoblin/issues"
  },
  "homepage": "https://github.com/funkyfunc/filegoblin#readme",
  "optionalDependencies": {
    "@filegoblin/darwin-arm64": "1.13.0",
    "@filegoblin/darwin-x64": "1.13.0",
    "@filegoblin/linux-x64": "1.13.0",
    "@filegoblin/linux-arm64": "1.13.0",
    "@filegoblin/win32-x64": "1.13.0"
  }
}
